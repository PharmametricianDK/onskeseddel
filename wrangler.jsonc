{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onskeseddel",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["assets_navigation_has_no_effect"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "html_handling": "none",
    "run_worker_first": ["/admin", "/admin/", "/admin.html", "/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "WISHLIST_BUCKET",
      "bucket_name": "onskeseddel-storage",
      "preview_bucket_name": "onskeseddel-storage-preview"
    }
  ],
  "vars": {
    "ADMIN_USERNAME": "admin"
  }
}

